#!/bin/sh
# Copy the shared UI pieces (app bar, typeface) into each app that ships them.
# Apps build from their own folder, so they need their own copy; tests fail on drift.
set -e
cd "$(dirname "$0")/.."
for dest in house/house/www/shared music/music/www/shared frame/shared; do
  mkdir -p "$dest"
  cp shared/appnav.js shared/tokens.css shared/archivo.woff2 shared/OFL-archivo.txt "$dest/"
done
echo "shared -> house, music, frame"
# Stamp a content hash on the links so phones and browsers never keep an old copy.
v=$(cat shared/appnav.js shared/tokens.css | sha1sum | cut -c1-8)
sed -i -E "s#shared/(appnav\.js|tokens\.css)(\?v=[0-9a-f]+)?#shared/\1?v=$v#g" house/house/www/index.html music/music/www/index.html frame/frame_app.py
echo "stamped v=$v"
